{
  "name": "LeJeu",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"App.tsx\"",
    "start": "react-native start",
    "test": "jest",
    "test:game": "jest src/game",
    "functions:build": "npm --prefix functions run build",
    "functions:deploy": "npm --prefix functions run deploy",
    "functions:serve": "npm --prefix functions run serve",
    "firebase:deploy:rules": "firebase deploy --only database,storage",
    "firebase:deploy:all": "firebase deploy --only functions,database,storage",
    "firebase:emulators": "firebase emulators:start --only functions,database,storage"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^16.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/database": "^24.0.0",
    "@react-native-firebase/functions": "^24.0.0",
    "@react-native-firebase/storage": "^24.0.0",
    "@react-native/new-app-screen": "0.85.3",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-document-picker": "^9.3.1",
    "react-native-gesture-handler": "^3.0.0",
    "react-native-reanimated": "^4.4.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.9.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
